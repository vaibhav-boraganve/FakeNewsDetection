# Copy to .env and adjust as needed.

# JWT signing secret - CHANGE THIS in any shared/deployed environment.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite database location
DATABASE_URL=sqlite:///./data/app.db

# Upload limits (MB)
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100

# Text transformer (Hugging Face). Leave empty to use only local weights in
# models/weights/text_transformer/ (if present) or the TF-IDF baseline.
# Downloaded once (~500 MB) and cached by Hugging Face on first start.
ENABLE_TRANSFORMER=true
TEXT_TRANSFORMER_MODEL=hamzab/roberta-fake-news-classification

# Download ImageNet weights for EfficientNet backbone (used by video CNN+LSTM features)
ENABLE_PRETRAINED_DOWNLOAD=true

# Number of frames sampled from each video
VIDEO_NUM_FRAMES=16

# Torch CPU threads (keep low on 8 GB / 4-core machines)
TORCH_THREADS=4
